<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
                   logicalFilePath="db.changelog-1.83.0.xml">

    <changeSet id="v1-82-0-tag"
               author="ramerav">
        <tagDatabase tag="v1.82.0"/> <!-- tag the current db version, i.e. the last  -->
    </changeSet>

    <changeSet id="20260512-7523-1" author="jainkhu">
        <insert tableName="settings">
            <column name="name" value="feature.data-flows-timeout-threshold-in-days"/>
            <column name="value" value="30"/>
            <column name="description" value="This specifies the threshold for days after which pending flows will time out."/>
            <column name="restricted" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="20260522-7523-2" author="kumarohb" >
        <modifyDataType columnName="flow_def"
                        newDataType="${clob.type}"
                        tableName="proposed_flow"/>
        <addNotNullConstraint tableName="proposed_flow"
                              columnName="flow_def"
                              columnDataType="${clob.type}"/>
        <comment>Update proposed_flow table to change flow_def to TEXT and add not-null constraint</comment>
    </changeSet>

    <changeSet id="20260707-survey-measurable-matrix-1" author="claude">
        <addColumn tableName="survey_run">
            <column name="involvement_resolution_kind"
                    type="${enum.type}"
                    defaultValue="TARGET_ENTITY">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <comment>Allows survey run recipients/owners to be resolved via involvement on either the target entity (default, existing behaviour) or the run's selector entity (e.g. a Measurable used to pick a population of Applications)</comment>
    </changeSet>

    <changeSet id="20260707-survey-measurable-matrix-2" author="claude">
        <addColumn tableName="survey_question">
            <column name="entity_qualifier_2_id"
                    type="${id.type}">
                <constraints nullable="true"/>
            </column>
            <column name="entity_qualifier_2_kind"
                    type="${enum.type}">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <comment>Second qualifier entity slot, for question field types needing two axes of configuration (e.g. MEASURABLE_MATRIX row/column measurable categories)</comment>
    </changeSet>

    <changeSet id="20260710-survey-one-active-instance-1" author="claude">
        <addColumn tableName="survey_template">
            <column name="one_active_instance_per_entity"
                    type="boolean"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <comment>When set, only one active (NOT_STARTED/IN_PROGRESS/COMPLETED) instance of this template is allowed per target entity (and per qualifier entity, e.g. Product, where applicable)</comment>
    </changeSet>

    <changeSet id="20260711-survey-prefill-from-previous-1" author="claude">
        <addColumn tableName="survey_run">
            <column name="prefill_from_last_approved_instance"
                    type="boolean"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <comment>When set, a newly-generated instance with no saved responses yet is prefilled from the latest APPROVED instance of the same template with the same target entity (and qualifier entity, where applicable), for any questions still compatible with the current template</comment>
    </changeSet>
</databaseChangeLog>